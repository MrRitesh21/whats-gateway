{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "WAFlow WhatsApp Gateway",
  "short_name": "WAFlow",
  "description": "Next-generation WhatsApp Gateway, Auto-Replies, Bulk Messenger, and Automation Platform",
  "id": "/?source=pwa",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090d16",
  "theme_color": "#10b981",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["business", "productivity", "utilities", "communication"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View WhatsApp gateway dashboard and statistics",
      "url": "/dashboard?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bulk Messenger",
      "short_name": "Bulk Send",
      "description": "Broadcast campaigns and messages",
      "url": "/dashboard/bulk-messenger?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Live Chat",
      "short_name": "Chat",
      "description": "Real-time multi-agent WhatsApp chat",
      "url": "/dashboard/chat?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "WhatsApp Sessions",
      "short_name": "Sessions",
      "description": "Manage WhatsApp accounts & QR codes",
      "url": "/dashboard/sessions?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
